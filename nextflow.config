
params {

  // help message
  help = ''

  workflow = "tb-typing.ngsservice"

  module_version = "0.5"

  // input directory
  indir = ""

  // filetype fastq or bam
  filetype = 'fastq'

  // glob pattern for input files
  readpat = '*_R{1,2}.fastq.gz'

  // output directory
  output_dir = ""

  // min reads for QC
  min_reads = "100000"

  // resistance params
  resistance_profiler = "tb-profiler"  
  update_tbprofiler = "no"
  collate = "yes"

  // path to this config file
  config_dir = "${baseDir}/nextflow.config"
  
  //path to resources directory
  pherefs_tb = "${PHENGS_SERVICE_ROOT}/pherefs/tb"
  resource_dir = "${pherefs_tb}/ukhsa_lodestone/v0.9.9-gamma/resources"

  //path to ref fasta and other index files
  tb_ref_fasta = "${resource_dir}/tuberculosis.fasta"
  tb_ref_dir   = "${resource_dir}/tuberculosis"
  species_of_interest = "Mycobacterium tuberculosis"
 
  // human/viral read removal; only 'tb_or_not_tb' is supported
  human_read_removal = "tb_or_not_tb"
  gem_index = "${pherefs_tb}/ukhsa_lodestone/gem3_indexes/indexes/HVMC.v3.175.ds.gem"

  //d1avolo
  speciation_method = "d1"
  d1_ref_fasta = "${pherefs_tb}/ukhsa_lodestone/d1avolo_speciation/d1avolo_0_47_5/"

  //fastlin 
  // Source: https://github.com/rderelle/barcodes-fastlin/
  fastlin_barcodes = "${pherefs_tb}/ukhsa_lodestone/fastlin_barcodes/MTBC_barcodes_v3.tsv"

  // default to tb-profiler
  variant_caller = "tb-profiler"
  tbdb_default_reference_genome = "${pherefs_tb}/tbprofiler_tbdb/genome.fasta"
  
  //vcf2fastq
  //low coverage depth_mask variable  
  lowdepth_threshold = 5
  //low quality mask MAPQ threshold
  mapq_mask = 20
}

process {
    container_path = "$NGSSERVICE_CONTAINER_PATH"
    queue = "$SLURM_PARTITION"

    params {
        tb_qaat_container = "$container_path/tb_typing_qaat/tb_typing_qaat_${TB_TYPING_QAAT_VERSION}.sinimg"
        tb_or_not_tb_container = "$container_path/tb_typing_tb_or_not_tb/tb_typing_tb_or_not_tb_${TB_TYPING_TB_OR_NOT_TB_VERSION}.sinimg"
        tbprofiler_container = "$container_path/tb_typing_tb_profiler/tb_typing_tb_profiler_${TB_PROFILER_VERSION}.sinimg"
        fastlin_container = "$container_path/tb_typing_fastlin/tb_typing_fastlin_${TB_TYPING_FASTLIN_VERSION}.sinimg"
        megahit_container = "$container_path/tb_typing_megahit/tb_typing_megahitb_${TB_TYPING_MEGAHITB_VERSION}.sinimg"
        //d1avolo_container = "$container_path/tb_typing_d1avolo/tb_typing_d1avolo_${TB_TYPING_D1AVOLO_VERSION}.sinimg"
        d1avolo_container = "$container_path/tb_typing_d1avolo/tb_typing_d1avolo_0.47.12.sinimg"
        //xml_container = "$container_path/tb_typing_tb_xml_generator/tb_xml_generator_${TB_XML_GENERATOR_VERSION}.sinimg"
        xml_container = "$container_path/tb_typing_tb_xml_generator/tb_xml_generator_0.4.sinimg"
        combine_xml_container = "$container_path/combine_xml/combine_xml_${COMBINE_XML_VERSION}.sinimg"
    }
    withLabel:tb_qaat {
        container = params.tb_qaat_container
        memory = { 8.GB * task.attempt }
        containerOptions = '--bind $PHENGS_BASE_PATH'
        clusterOptions = '-m cyclic'
        cpus = 4
    }

    //this container needs more memory to read the index file
    withLabel:tb_or_not_tb {
        container = params.tb_or_not_tb_container
        memory = { 64.GB * task.attempt }
        containerOptions = '--bind $PHENGS_BASE_PATH,$PHENGS_SERVICE_ROOT/pherefs:/mnt'
        clusterOptions = '-m cyclic'
        cpus = 8
    }

    withLabel:tbprofiler {
        container = params.tbprofiler_container
        memory = { 48.GB * task.attempt }
        containerOptions = '--bind $PHENGS_BASE_PATH'
        clusterOptions = '-m cyclic'
        cpus = 4

        // We use JAVA_TOOL_OPTIONS because it is automatically picked up by any JVM
        // We calculate 80% of the allocated task memory to leave room for the container OS
        beforeScript = {
            """
            export JAVA_TOOL_OPTIONS="-Xmx${(task.memory.toGiga() * 0.8).toInteger()}g -XX:+UseG1GC"
            """
        }
    }
    
    withLabel:fastlin {
        container = params.fastlin_container
        memory = { 4.GB * task.attempt }
        containerOptions = '--bind $PHENGS_BASE_PATH'
        clusterOptions = '-m cyclic'
        cpus = 2
    }

    withLabel:megahit {
        container = params.megahit_container
        memory = { 8.GB * task.attempt }
        containerOptions = '--bind $PHENGS_BASE_PATH'
        clusterOptions = '-m cyclic'
        cpus = 8
    }
    withLabel:d1avolo {
        container = params.d1avolo_container
        memory = { 16.GB * task.attempt }
        containerOptions = '--bind $PHENGS_BASE_PATH'
        clusterOptions = '-m cyclic'
        cpus = 8
    }
    withLabel:tb_xml_generator {
        container = params.xml_container
        memory = { 4.GB * task.attempt }
        containerOptions = '--bind $PHENGS_BASE_PATH'
        clusterOptions = '-m cyclic'
        cpus = 2
    }
    withLabel:tb_combine_xml {
        container = params.combine_xml_container
        memory = { 4.GB * task.attempt }
        containerOptions = '--bind $PHENGS_BASE_PATH'
        clusterOptions = '-m cyclic'
        cpus = 2
    }

}

singularity {
    enabled = true
    newPidNamespace = false
}
executor {
    name = 'slurm'
    exitReadTimeout = '7200 sec'
    //queueSize = "$SLURM_LARGE_QUEUE_SIZE"
    queueSize = 50
}
process.module = 'singularity/singularity-3.4.1'

//error handling
workflow.failOnIgnore = true
process.errorStrategy = 'retry'
process.maxRetries = 2
//process.errorStrategy = 'ignore'


